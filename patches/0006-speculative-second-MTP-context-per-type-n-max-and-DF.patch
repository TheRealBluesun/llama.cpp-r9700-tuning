+    void accept(llama_seq_id seq_id, uint16_t n_accepted, bool is_other) override {
+        if (is_dspark || is_other) {
+            return;
+        }
+        if (seq_id < 0 || seq_id >= (llama_seq_id) acc_ema.size()) {
+            return;
